  "prep": [
    {
      "id": "prep_cucumber",
      "title": "处理黄瓜并脱水",
      "action": "{{cucumber}} 洗净，用刀面拍裂后切成约3cm的段；撒入 {{salt}} 抓匀，静置10分钟，倒掉渗出的水分。",
      "uses": [
        {
          "ingredientId": "cucumber",
          "fraction": 1
        },
        {
          "ingredientId": "salt",
          "fraction": 1
        }
      ],
      "seconds": 600,
      "parallel": "静置期间可同步准备蒜末和料汁。"
    },
    {
      "id": "prep_sauce",
      "title": "调凉拌料汁",
      "action": "{{garlic}} 拍碎切末，放入小碗，加入 {{vinegar}}、{{soy_sauce}}、{{sesame_oil}} 和 {{sugar}}，搅拌至糖溶化。",
      "uses": [
        {
          "ingredientId": "garlic",
          "fraction": 1
        },
        {
          "ingredientId": "vinegar",
          "fraction": 1
        },
        {
          "ingredientId": "soy_sauce",
          "fraction": 1
        },
        {
          "ingredientId": "sesame_oil",
          "fraction": 1
        },
        {
          "ingredientId": "sugar",
          "fraction": 1
        }
      ],
      "seconds": 120,
      "parallel": ""
    }
  ],
  "steps": [
    {
      "id": "mix",
      "title": "拌匀装盘",
