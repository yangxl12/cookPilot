{
  "schemaVersion": 1,
  "title": "凉拌黄瓜",
  "aliases": ["拍黄瓜", "蒜泥黄瓜"],
  "cuisine": "中式",
  "minutes": 15,
  "difficulty": "简单",
  "conditions": "常规一盘，黄瓜2根约400g，现拌现吃",
  "cookware": ["碗"],
  "keyPoints": [
    "黄瓜拍裂比刀切更入味。",
    "先用盐脱水再倒掉水分，避免出汤稀释味道。",
    "蒜末和香醋最后拌匀，现拌现吃口感最脆。"
  ],
